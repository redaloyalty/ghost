# delta: readable diffs in the terminal (git diff, git show, git log -p)
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true          # n / N jump between files
    side-by-side = true
    line-numbers = true
    syntax-theme = Nord
    file-style = bold "#8fbf8f"
    hunk-header-style = omit
    minus-style = syntax "#2a1614"
    plus-style = syntax "#142a1a"
[merge]
    conflictstyle = zdiff3
