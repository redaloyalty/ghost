[global]
    monitor = 0
    follow = mouse
    width = 380
    origin = top-right
    offset = 16x48
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    frame_color = "#2a2f2a"
    separator_color = frame
    corner_radius = 6
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
[urgency_low]
    background = "#0a0a0aee"
    foreground = "#7d8079"
[urgency_normal]
    background = "#0a0a0aee"
    foreground = "#d6d3cb"
    frame_color = "#8fbf8f"
[urgency_critical]
    background = "#0a0a0aee"
    foreground = "#d6d3cb"
    frame_color = "#c2564a"
