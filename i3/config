# i3 - Ghost. Every key is in ../KEYS.md (Super+/ shows it).
set $mod Mod4
set $term kitty
font pango:JetBrainsMono Nerd Font 10
floating_modifier $mod

# look
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 10
gaps outer 4
# class                 border  bg      text    indicator child_border
client.focused          #8fbf8f #121412 #d6d3cb #b6e3a8   #8fbf8f
client.focused_inactive #2a2f2a #0a0a0a #7d8079 #2a2f2a   #2a2f2a
client.unfocused        #1a1d1a #0a0a0a #7d8079 #1a1d1a   #1a1d1a
client.urgent           #c2564a #0a0a0a #d6d3cb #c2564a   #c2564a
client.background       #0a0a0a

# startup
# big screen (DP-2) physically on the left; X11 puts it right by default
exec_always --no-startup-id ~/dotfiles/bin/screens
exec_always --no-startup-id ~/dotfiles/bin/wall
exec_always --no-startup-id ~/dotfiles/bin/compositor
exec_always --no-startup-id ~/dotfiles/polybar/launch.sh
exec --no-startup-id dunst
exec --no-startup-id nm-applet
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/dotfiles/bin/lock
exec --no-startup-id ~/dotfiles/bin/first-run

# workspaces: 1-5 on the big screen, 6-10 on the laptop
set $ws1 "1:TERM"
set $ws2 "2:WEB"
set $ws3 "3:CODE"
set $ws4 "4:NOTES"
set $ws5 "5:MIND"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
workspace $ws1 output DP-2 primary
workspace $ws2 output DP-2 primary
workspace $ws3 output DP-2 primary
workspace $ws4 output DP-2 primary
workspace $ws5 output DP-2 primary
workspace $ws6 output eDP-1
workspace $ws7 output eDP-1
workspace $ws8 output eDP-1
workspace $ws9 output eDP-1
workspace $ws10 output eDP-1

# chat apps first (more specific), they live on the laptop screen
assign [instance="web.whatsapp.com"] $ws6
assign [instance="teams.microsoft.com"] $ws6
assign [class="(?i)google-chrome|firefox|brave"] $ws2
assign [class="(?i)code"] $ws3
assign [class="(?i)obsidian"] $ws4
for_window [class="mind-float"] floating enable, resize set 900 600, move position center
for_window [class="keys-float"] floating enable, resize set 820 760, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable

# open things
bindsym $mod+Return exec $term
bindsym $mod+d exec rofi -show drun
bindsym $mod+Tab exec rofi -show window
bindsym $mod+space exec ~/dotfiles/bin/mind-ask
bindsym $mod+m exec kitty --class mind-float --title mind -e mind chat
bindsym $mod+slash exec ~/dotfiles/bin/keys
bindsym $mod+b exec google-chrome
bindsym $mod+Shift+b exec firefox
bindsym $mod+Shift+w exec google-chrome --app=https://web.whatsapp.com
bindsym $mod+Shift+t exec google-chrome --app=https://teams.microsoft.com
bindsym $mod+c exec code
bindsym $mod+o exec obsidian
bindsym $mod+a exec kitty --directory ~/ll --title claude -e claude
bindsym $mod+e exec kitty --title ranger -e ranger
bindsym $mod+n exec nautilus
bindsym $mod+i exec ~/dotfiles/bin/stats

# windows
bindsym $mod+Shift+q kill
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+backslash split h
bindsym $mod+minus split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+period focus mode_toggle
bindsym $mod+comma move workspace to output next

# workspaces
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# screens with Control: Ctrl+Alt+arrows jump, + Shift carries the window along
bindsym Ctrl+Mod1+Left focus output left
bindsym Ctrl+Mod1+Right focus output right
bindsym Ctrl+Mod1+Shift+Left move container to output left; focus output left
bindsym Ctrl+Mod1+Shift+Right move container to output right; focus output right
bindsym Ctrl+Mod1+1 workspace number $ws1
bindsym Ctrl+Mod1+2 workspace number $ws2
bindsym Ctrl+Mod1+3 workspace number $ws3
bindsym Ctrl+Mod1+4 workspace number $ws4
bindsym Ctrl+Mod1+5 workspace number $ws5
bindsym Ctrl+Mod1+6 workspace number $ws6
bindsym Ctrl+Mod1+7 workspace number $ws7
bindsym Ctrl+Mod1+8 workspace number $ws8
bindsym Ctrl+Mod1+9 workspace number $ws9
bindsym Ctrl+Mod1+0 workspace number $ws10

# resize mode
mode "resize" {
  bindsym h resize shrink width 40 px
  bindsym j resize grow height 40 px
  bindsym k resize shrink height 40 px
  bindsym l resize grow width 40 px
  bindsym Left resize shrink width 40 px
  bindsym Down resize grow height 40 px
  bindsym Up resize shrink height 40 px
  bindsym Right resize grow width 40 px
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# session
bindsym $mod+Escape exec ~/dotfiles/bin/lock
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec ~/dotfiles/bin/power

# screenshots -> ~/Pictures/Screenshots
bindsym Print exec --no-startup-id ~/dotfiles/bin/shot
bindsym --release Shift+Print exec --no-startup-id ~/dotfiles/bin/shot area
bindsym --release $mod+Shift+s exec --no-startup-id ~/dotfiles/bin/shot area

# media keys
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl -q set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -q set 5%-
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
