#!/bin/sh
# do not disturb: pause notifications (they wait, nothing is lost); again to resume
if [ "$(dunstctl is-paused)" = "true" ]; then
  dunstctl set-paused false; notify-send -t 1500 "Notifications on" "anything that came in shows now"
else
  notify-send -t 1200 "Do not disturb" "notifications wait until Super+Ctrl+\`"; sleep 1.3; dunstctl set-paused true
fi
