#!/bin/sh
# external left + primary, laptop right. If the external is unplugged, laptop only.
if xrandr | grep -q "^DP-2 connected"; then
  xrandr --output DP-2 --primary --mode 1920x1080 --pos 0x0 --output eDP-1 --mode 1920x1080 --pos 1920x0
else
  xrandr --output eDP-1 --primary --auto --pos 0x0
fi
