#!/bin/sh
# Super+Shift+o: OBS on the LL demo setup (1080p60, Chrome window only, ~/Videos/LL).
# Notifications are muted while OBS is open, so nothing pops up mid-demo.
pgrep -x obs >/dev/null && exit 0
dunstctl set-paused true
obs --profile LL --collection Ghost --scene "LL demo - Chrome window" >/dev/null 2>&1
dunstctl set-paused false
