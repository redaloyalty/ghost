diff --git a/unlock_indicator.c b/unlock_indicator.c
index e10984a..b0eb54b 100644
--- a/unlock_indicator.c
+++ b/unlock_indicator.c
@@ -596,6 +596,27 @@ static void draw_indic(cairo_t *ctx, double ind_x, double ind_y) {
             cairo_arc(ctx, ind_x, ind_y, BUTTON_RADIUS - 5, 0, 2 * M_PI);
             cairo_stroke(ctx);
         }
+        /* Face scan: while PAM verifies, a sweep circles the ring and a line moves through it. */
+        if (auth_state == STATE_AUTH_VERIFY) {
+            struct timespec now;
+            clock_gettime(CLOCK_MONOTONIC, &now);
+            double t = now.tv_sec + now.tv_nsec / 1e9;
+            double start = fmod(t * 2 * M_PI * 0.9, 2 * M_PI);
+            cairo_set_line_width(ctx, RING_WIDTH);
+            cairo_new_sub_path(ctx);
+            cairo_arc(ctx, ind_x, ind_y, BUTTON_RADIUS, start, start + M_PI / 2.5);
+            cairo_set_source_rgba(ctx, keyhl16.red, keyhl16.green, keyhl16.blue, keyhl16.alpha);
+            cairo_stroke(ctx);
+
+            double r = BUTTON_RADIUS - RING_WIDTH;
+            double dy = r * 0.8 * sin(t * M_PI * 1.2);
+            double half = sqrt(fmax(r * r - dy * dy, 0));
+            cairo_set_line_width(ctx, 2.0);
+            cairo_move_to(ctx, ind_x - half, ind_y + dy);
+            cairo_line_to(ctx, ind_x + half, ind_y + dy);
+            cairo_set_source_rgba(ctx, ringver16.red, ringver16.green, ringver16.blue, ringver16.alpha * 0.8);
+            cairo_stroke(ctx);
+        }
         if (unlock_state == STATE_KEY_ACTIVE || unlock_state == STATE_BACKSPACE_ACTIVE) {
