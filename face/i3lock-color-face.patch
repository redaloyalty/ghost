+    struct timespec fast = {0, 40000000};
+    double every = ts->tv_sec + ts->tv_nsec / 1e9, waited = 0;
     while (1) {
-        nanosleep(ts, NULL);
-        redraw_screen();
+        nanosleep(&fast, NULL);
